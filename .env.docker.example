# docker-compose 전용 환경변수 템플릿
# 사용법: 이 파일을 .env.docker로 복사한 뒤 실제 값을 채운다.
#   cp .env.docker.example .env.docker
#
# DB_*, MQTT_BROKER_* 는 docker-compose.yml의 environment: 블록에서
# 서비스명(db, mosquitto) 기준으로 이미 채워지므로 여기 다시 적지 않는다.
# 여기에는 컨테이너 밖에서 값을 알 수 없는 실제 시크릿만 넣는다.

ANTHROPIC_API_KEY=sk-ant-...
SECRET_KEY=change-this-to-a-random-string
